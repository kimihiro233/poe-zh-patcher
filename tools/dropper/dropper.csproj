<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PoE-zh-Patcher</AssemblyName>
    <RootNamespace>PoeZhPatcher</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibGGPK3.LibBundledGGPK3" Version="2.7.5" />
    <PackageReference Include="LibGGPK3.LibBundle3" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\lib\oo2core.dll" Link="oo2core.dll" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\pack\bundle.gz" LogicalName="bundle.gz" />
  </ItemGroup>

</Project>
