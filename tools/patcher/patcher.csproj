<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>patcher</AssemblyName>
    <RootNamespace>Patcher</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibGGPK3.LibBundledGGPK3" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\lib\oo2core.dll" Link="oo2core.dll" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\shared\LanguageSwitch.cs" Link="LanguageSwitch.cs" />
    <Compile Include="..\shared\FlagIcon.cs" Link="FlagIcon.cs" />
  </ItemGroup>

</Project>
