# 二进制原始导出：可从 Content.ggpk 重新生成，不入库
pairs/
raw/
raw_sd/

# 构建产物
tools/*/bin/
tools/*/obj/
tools/*/build.log
tools/*/*.log

# 大体积派生产物（43MB，可由 dumper 重跑）
out/pairs.csv

# 补丁输出（由 patch_dat.py 生成）与打包快照
out/patch/*
!out/patch/manifest.json
out/patch-sd*/
releases/*.zip

# 补丁器构建产物（37 MB，dotnet publish 重新生成；发布包里带一份）
dist/

# 结构演练的回读镜像
out/simtest/

# 异地采集包：里面是客户端日志（账号、SteamID、C:\Users\<真名>\…）与容器全路径，
# 只留分析结论。注意必须写成 `out/collect-*/*` 而不是 `out/collect-*/` ——
# 父目录一旦被整体忽略，后面的 `!` 否定规则就进不去，等于白写。
out/collect-*/*
!out/collect-*/ANALYSIS.md
!out/collect-*/syntax-check.md
!out/collect-*/*-diff.csv
# 采集包打出来的 zip 同理（内容是上面那些 txt/json）
out/collect-*.zip

# 旧游戏锁留档（需要时可由 git 历史里的 game.lock.json 找回）
out/game-lock-history/

# 写入前的临时备份与回读校验导出
out/backup/
out/ggpk-backup-*/
out/verify*/
out/out/

# 游戏本体
*.ggpk

# WorkBuddy 会话/记忆目录（项目记录写在 notes/，这里不入库）
.workbuddy/

# WorkBuddy 会话/记忆目录（项目记录写在 notes/，这里不入库）
.workbuddy-ai/
